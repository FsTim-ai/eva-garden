# Port the backend listens on
PORT=3001

# Must match the systemId the frontend reads from (src/components/Dashboard.tsx)
SYSTEM_ID=rooftop-main

# From firebase-applet-config.json -> firestoreDatabaseId
FIRESTORE_DATABASE_ID=ai-studio-06ed7652-dbf2-432b-8ba8-36890d139c87

# Path to the service account JSON downloaded from Firebase console
# (Project Settings -> Service accounts -> Generate new private key).
# Used for local development.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Alternative to GOOGLE_APPLICATION_CREDENTIALS: paste the full service
# account JSON as a single-line string. Use this on hosts (Render, Railway,
# etc.) where you can't upload the gitignored key file — set it in the
# platform's environment variable dashboard instead. Takes priority over
# GOOGLE_APPLICATION_CREDENTIALS when set.
FIREBASE_SERVICE_ACCOUNT=

# Optional shared secret the ESP32 must send as the `x-api-key` header.
# Leave blank while testing locally; set it before exposing this server to a network.
SENSOR_API_KEY=
